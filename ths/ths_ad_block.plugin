#!name=Tonghuashun Ad Blocker
#!desc=Remove the ths ads
#!icon=https://raw.githubusercontent.com/quentinjwhu/ad-block-scripts/main/ths/icon.png

[General]
name = Tonghuashun Ad Blocker
desc = Unified JS script to block splash ads, in-feed ads, and analytics tracking for Tonghuashun App
author = User
version = 1.1.0

[MITM]
hostname = *.10jqka.com.cn, *.hexin.cn

[Script]
# Unified ad interception - dispatched by single script based on URL
http-response ^https?:\/\/(adm|stat|ad|ads|dsp|adapi)\.10jqka\.com\.cn\/.* script-path=https://raw.githubusercontent.com/quentinjwhu/ad-block-scripts/main/ths/ths_ad_block.js, requires-body=true, tag=Tonghuashun-Ad-Block

# Analytics tracking - rejected at request stage
http-request ^https?:\/\/stat\.10jqka\.com\.cn\/(?!.*kaiping).* script-path=https://raw.githubusercontent.com/quentinjwhu/ad-block-scripts/main/ths/ths_stat_block.js, tag=Tonghuashun-Stat-Block
